{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run agent once",
			"type": "shell",
			"command": "python -m src.agent --config plc-mirror/config.yaml --once",
			"args": [],
			"problemMatcher": [
				"$python"
			],
			"group": "build"
		},
		{
			"label": "Run agent once (workspace path)",
			"type": "shell",
			"command": "python -c \"import sys; sys.path.append('plc-mirror'); import src.agent as a; a.main()\"",
			"args": [],
			"problemMatcher": [
				"$python"
			],
			"group": "build"
		},
		{
			"label": "Check Prometheus metrics",
			"type": "shell",
			"command": "curl http://localhost:9108/metrics"
		},
		{
			"label": "Verificar logs do agente para publicação MQTT",
			"type": "shell",
			"command": "type logs\\collector.log | findstr /i mqtt"
		},
		{
			"label": "Verificar logs do agente para publicação MQTT (stdout)",
			"type": "shell",
			"command": "type plc-mirror\\logs\\collector.log | findstr /i mqtt"
		},
		{
			"label": "Verificar logs do agente para publicação MQTT (log alternativo)",
			"type": "shell",
			"command": "type plc-mirror\\logs\\collector.log"
		},
		{
			"label": "Verificar métricas Prometheus diretamente",
			"type": "shell",
			"command": "curl http://localhost:9108/metrics"
		},
		{
			"label": "Verificar logs de sucesso/falha MQTT",
			"type": "shell",
			"command": "type plc-mirror\\logs\\collector.log | findstr /i mqtt"
		}
	]
}