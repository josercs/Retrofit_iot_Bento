{
  "uid": "plc-resumo",
  "title": "PLC – Resumo",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "title": "Contador Bom (Atual)",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "R951FEA4DE68E13C5"
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"processo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"s7_db1\")\n  |> filter(fn: (r) => r._field == \"contador_bom\")\n  |> last()"
        }
      ]
    },
    {
      "title": "Contador Ruim (Atual)",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "R951FEA4DE68E13C5"
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"processo\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"prometheus\")\n  |> filter(fn: (r) => r.name == \"contador_ruim\")\n  |> filter(fn: (r) => not exists r.tenant_id or v.varTenant == \"All\" or r.tenant_id == v.varTenant)\n  |> filter(fn: (r) => not exists r.plc_id or v.varPlc == \"All\" or r.plc_id == v.varPlc)\n  |> last()"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "varTenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "R951FEA4DE68E13C5"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"processo\", tag: \"tenant_id\")",
        "includeAll": true,
        "allValue": "All",
        "refresh": 1
      },
      {
        "name": "varPlc",
        "label": "PLC",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "R951FEA4DE68E13C5"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"processo\", tag: \"plc_id\")",
        "includeAll": true,
        "allValue": "All",
        "refresh": 1
      }
    ]
  }
}
